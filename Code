# ── STEP 2: RESPONSE ENGINE ───
def get_response(user_input: str) -> str:

    # lowercase + remove whitespace
    clean_input = user_input.lower().strip()

    # Exit Strategy
    if clean_input in ("exit", "quit", "q", "stop", "close"):
        return "__EXIT__"

    # Dictionary lookup with fallback (from .get() method slide)
    reply = responses.get(
        clean_input,
        "🤔 I don't understand that yet. Try: 'hello', 'what is AI', 'tell me a joke', or 'bye'."
    )
    return reply


# ── STEP 3: INFINITE LOOP ──
def run_chatbot():
    """
    Continuous 'while True' loop — the organism stays alive
    until the Kill Command (exit/quit) is received.
    """

    print("  ——————————————— Rule-Based AI Chatbot ———————————————")
    print("  Type 'exit' or 'quit' to stop the chatbot.")
    print("  Try: hello | what is AI | tell me a joke | bye")
    print("-" * 55)

    # ── THE INFINITE LOOP (while True) ───
    while True:

        # Phase 1: INPUT
        raw_input = input("\nYou: ")

        # Phase 2: PROCESS
        response = get_response(raw_input)

        # Phase 3: OUTPUT
        if response == "__EXIT__":
            print("\nDecoBot: Goodbye! Thanks for chatting. 👋")
            break   # break from loop

        print(f"DecoBot: {response}")


# ── ENTRY POINT ───
if __name__ == "__main__":
    run_chatbot()
